# Variables del perfil de producción (docker-compose.prod.yml).
#
# Este fichero NO es el que usa el stack de desarrollo: docker-compose.yml
# funciona sin él, porque sus valores vienen del propio compose y los drivers
# conectan contra subsistemas de prueba. Aquí sí hace falta, y hace falta
# entero.
#
# Uso:
#   cp .env.example .env
#   docker compose exec app php artisan key:generate --show
#   # pegar la clave en APP_KEY y rellenar las contraseñas de abajo
#   docker compose -f docker-compose.prod.yml up --build -d
#   docker compose -f docker-compose.prod.yml exec app php artisan migrate --force
#
# .env está en .gitignore. Si alguna vez se sube, hay que rotar todo lo que
# contiene, no solo las contraseñas: por eso el fichero se copia de la plantilla
# y nunca al revés.

APP_NAME="Gerenciador de Usuarios"
APP_ENV=production

# Generar con `php artisan key:generate --show` (dentro del contenedor: se escribe
# .env de trabajo, y --show lo imprime en vez de tocar el fichero).
#
# AVISO: rotar APP_KEY más adelante no es un cambio menor. Todo lo cifrado con
# la clave anterior queda ilegible: api_config de los subsistemas (que guarda las
# credenciales de integración) y los payloads de las operaciones pendientes.
# Restablecer la clave sin recifrar es perder esas cuentas de forma silenciosa.
APP_KEY=

# El proxy que hay delante termina TLS y nginx solo recibe HTTP, así que la URL
# pública va con https aunque el contenedor hable en claro.
APP_URL=https://gerenciador.ejemplo.com

# false en producción, siempre. Un APP_DEBUG olvidado en true enseña trazas de
# pila, rutas y valores de variables a quien adivine una URL.
APP_DEBUG=false

# Puerto que publica nginx en el host. El único del stack.
APP_PORT=8085

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Base de datos -------------------------------------------------------
# DB_HOST y DB_PORT los sobrescribe el compose: la aplicación siempre habla con
# el contenedor mysql por la red interna, nunca con una IP del host.
DB_CONNECTION=mysql
DB_DATABASE=gerenciador
DB_USERNAME=gerenciador
DB_PASSWORD=

# Credenciales que usa el propio contenedor mysql para inicializarse.
# MYSQL_PASSWORD debe coincidir con DB_PASSWORD: si no, la aplicación conecta
# con una contraseña y el servidor rechaza la conexión.
MYSQL_DATABASE=gerenciador
MYSQL_USER=gerenciador
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Estado de la aplicación ---------------------------------------------
# Los tres en `database` a propósito. Redis se retiró en el Sprint 2.3 porque
# ningún contenedor lo usaba, y en producción el estado no puede vivir en el
# disco de un contenedor efímero: `down` seguido de `up` borraría las sesiones
# de todos y las operaciones encoladas se perderían sin dejar rastro.
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
SESSION_LIFETIME=120

BROADCAST_DRIVER=log
FILESYSTEM_DISK=local

# Las vistas compiladas fuera de storage/ porque el contenedor corre como root
# y php-fpm como www-data; escribirlas en storage/ obligaría a hacerlas
# escribibles por www-data y el arranque sería una carrera entre los dos.
VIEW_COMPILED_PATH=/tmp/laravel-views

# Solo si hay un proxy que reescriba X-Forwarded-For. Sin esto, request()->ip()
# devuelve la IP del proxy y la auditoría registra siempre el mismo origen.
# APP_TRUSTED_PROXIES=

# --- Correo --------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@ejemplo.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
