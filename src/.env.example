APP_NAME="Gestor de Usuarios"
APP_ENV=local
APP_KEY=
# false a propósito: con APP_DEBUG=true, un error inesperado devuelve la
# excepción completa al navegador (traza, ruta de fichero, valores del
# entorno). El detalle va al log, que es donde se busca.
APP_DEBUG=false
APP_URL=http://localhost:8085

# La interfaz está en español (texto literal en las vistas, no hay carpeta
# lang/). El locale afecta sobre todo a los mensajes de validación y a las
# fechas que emite Laravel.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gerenciador
DB_USERNAME=laravel
DB_PASSWORD=laravel

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis no se usa: cola, caché y sesión van a `database` (Sprint 2.3).
# Si se vuelve a necesitar, hay que además instalar la extensión phpredis
# en docker/php/Dockerfile, que no está.

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Los tenant y client_id de Entra ID son identificadores reales de la
# organización: se rellenan en cada instalación con los valores de ese
# cliente. Van vacíos a propósito para que este ejemplo no los arrastre.
ENTRAID_KLIOS_TENANT_ID=
ENTRAID_KLIOS_CLIENT_ID=
ENTRAID_KLIOS_CLIENT_SECRET=
ENTRAID_KLIOS_DOMINIO=klios.com.br

ENTRAID_FEDERALST_TENANT_ID=
ENTRAID_FEDERALST_CLIENT_ID=
ENTRAID_FEDERALST_CLIENT_SECRET=
ENTRAID_FEDERALST_DOMINIO=federalst.com.br
