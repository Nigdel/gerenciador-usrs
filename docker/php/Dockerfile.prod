# Imagen de producción.
#
# Va aparte de docker/php/Dockerfile a propósito: el de desarrollo monta el
# código por volumen y trae herramientas para trabajar, y meterle un build de
# producción dentro habría que desactivarlas todas cada vez que se quisiera
# depurar en local. Aquí la imagen es autosuficiente: se compila el código y los
# assets dentro, así que el despliegue no depende del estado del host.
#
# El contexto de build es la raíz del repositorio (.), no docker/php/, porque hay
# que copiar tanto src/ como docker/.

# ---------------------------------------------------------------------------
# Assets: compila Vite/Tailwind.
#
# `public/build` está en .gitignore, así que no se puede copiar desde el host:
# si no se compila aquí, la imagen llega sin CSS ni JS y la web se ve rota.
# Se copia solo el manifiesto antes de instalar para que la capa de
# dependencias se reutilice mientras el lockfile no cambie, que es donde se va
# el tiempo de este build.
# ---------------------------------------------------------------------------
FROM node:22-alpine AS assets

WORKDIR /build

COPY src/package.json src/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY src/vite.config.js ./
COPY src/resources/ ./resources/

RUN npm run build

# ---------------------------------------------------------------------------
# Imagen final.
# ---------------------------------------------------------------------------
FROM php:8.5-fpm AS php

WORKDIR /var/www

RUN apt-get update && apt-get install -y \
    git \
    curl \
    unzip \
    libzip-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libonig-dev \
    libxml2-dev \
    libicu-dev \
    libpq-dev \
    libldap2-dev \
    ca-certificates \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-configure ldap --with-libdir="lib/$(dpkg-architecture --query DEB_BUILD_MULTIARCH)" \
    && docker-php-ext-install \
        pdo_mysql \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        intl \
        zip \
        ldap \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# opcache no aparece en la lista de arriba a propósito: la imagen php:8.5-fpm
# ya lo trae compilado y activo, y en PHP 8.5 es una Zend extension, así que
# `docker-php-ext-install opcache` compila sin llegar a producir ningún módulo y
# rompe el build con `cp: cannot stat 'modules/*'`. Lo que sí hace falta —y está
# en php.ini.prod— es ajustarlo (opcache.enable_cli=0, validate_timestamps=0).
#
# El CA de Klios hace falta para hablar con Samba (LDAP sobre TLS); sin él, el
# alta en subsistemas falla con un error de certificado que no dice nada de
# certificados.
COPY docker/php/klios-samba-ca.crt /usr/local/share/ca-certificates/klios-samba-ca.crt
RUN update-ca-certificates

COPY docker/php/php.ini.prod /usr/local/etc/php/conf.d/zz-app.ini
COPY docker/php/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Se copia el manifiesto antes que el código: composer install va en su propia
# capa, así que un cambio en un fichero de aplicación no vuelve a descargar
# dependencias.
COPY src/composer.json src/composer.lock ./
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-autoloader \
    --no-interaction \
    --prefer-dist

COPY src/ /var/www/
COPY --from=assets /build/public/build/ /var/www/public/build/

# bootstrap/cache/ viene con la imagen del repositorio y hay que vaciarlo ANTES
# de regenerar el autoload. Esos ficheros (packages.php y services.php) son un
# índice de paquetes que se generó con las dependencias de desarrollo
# instaladas: si `composer install --no-dev` deja fuera `laravel/boost` pero el
# manifiesto copiado del repositorio sigue nombrando su service provider,
# `package:discover` aborta con `Class "Laravel\Boost\BoostServiceProvider" not
# found` y el build muere. Se borran y se dejan que Laravel los regenere sin las
# dependencias que ya no están.
RUN rm -f bootstrap/cache/*.php

# Las vistas compiladas y los cachés van a /tmp porque el contenedor corre como
# root y php-fpm como www-data: si vivieran en storage/ habría que hacerlos
# escribibles por www-data, y el arranque se convertiría en una carrera entre
# los dos procesos.
#
# OJO: los cachés de Laravel (config, rutas, vistas) NO se generan aquí a
# propósito. `config:cache` fija el valor de cada variable de entorno dentro de
# la imagen, y las credenciales y APP_KEY llegan en tiempo de ejecución desde
# compose: si se compilaran en el build, la aplicación arrancaría con la
# configuración del build y no con la del despliegue. Los genera el entrypoint
# en cada arranque.
RUN mkdir -p /tmp/laravel-views \
    && composer dump-autoload --optimize --no-dev \
    && chown -R www-data:www-data /tmp/laravel-views /var/www/storage /var/www/bootstrap/cache

EXPOSE 9000

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["php-fpm", "-F"]

# ---------------------------------------------------------------------------
# Imagen de nginx.
#
# Es un stage aparte, y no el nginx:alpine del compose, por una razón concreta:
# en producción el código va compilado DENTRO de la imagen y no hay volúmenes,
# así que un nginx independiente se encontraría /var/www/public vacío y
# respondería 404 a todo —que es justo el error que sale, y no dice nada de que
# el código esté en otro contenedor—. Al copiar aquí el mismo public/ que ve
# php-fpm, los dos sirven exactamente los mismos ficheros.
#
# De este stage solo se copia public/, sin vendor ni código de aplicación:
# nginx no ejecuta PHP, solo le pasa index.php a php-fpm por FastCGI.
#
# Es el ÚLTIMO stage a propósito: el que no lleva `target:` en el compose es el
# que se construye por defecto, y ese tiene que ser el de la aplicación. Con el
# orden invertido, el ENTRYPOINT y el CMD de php-fpm acaban aplicándose a nginx y
# el contenedor de app ni arranca ("no such file or directory").
# ---------------------------------------------------------------------------
FROM nginx:alpine AS web

COPY docker/nginx/prod.conf /etc/nginx/conf.d/default.conf
COPY --from=php /var/www/public/ /var/www/public/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]